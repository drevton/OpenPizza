// Shared native/save record schema. Included to emit field tables, record
// registration and compile-time layout checks. Field order and IDs are part
// of the format contract; pointer targets name codecs at this boundary.
// SAVED_RECORD(kind, Native, saved_size, fields), SAVED_VALUE(...),
// SAVED_REFERENCE(...), SAVED_SPAN(...), SAVED_BYTES(...), SAVED_END_RECORD().

SAVED_RECORD(PT_RESOURCE_KIND_IGLOO_LINK, IglooLink, sizeof(PTSavedIglooLink), saved_igloolink_fields)
SAVED_VALUE(PT_RESOURCE_FIELD_0, IglooLink, field_0)
SAVED_REFERENCE(PT_RESOURCE_FIRST, IglooLink, first, serialized_first_igloo, PT_RESOURCE_KIND_IGLOO)
SAVED_REFERENCE(PT_RESOURCE_LAST, IglooLink, last, serialized_last_igloo, PT_RESOURCE_KIND_IGLOO)
SAVED_END_RECORD()


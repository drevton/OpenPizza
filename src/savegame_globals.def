SAVED_GLOBAL(blitmap_offsets, false)
// Original columns contain eight history rows followed by eight target rows.
// Keep serialization order here; native gameplay owns per-player records.

#define SAVED_GOAL_ROW(member, address, stride, player, section, row)                                                  \
  SAVED_VIEW(player_goals[player].section.member,                                                                      \
      (address) + (row) * (stride),                                                                                    \
      sizeof(player_goals[player].section.member),                                                                     \
      false)
#define SAVED_GOAL_COLUMN(member, address, stride)                                                                     \
  SAVED_GOAL_ROW(member, address, stride, 0, history, 0u)                                                              \
  SAVED_GOAL_ROW(member, address, stride, 1, history, 1u)                                                              \
  SAVED_GOAL_ROW(member, address, stride, 2, history, 2u)                                                              \
  SAVED_GOAL_ROW(member, address, stride, 3, history, 3u)                                                              \
  SAVED_GOAL_ROW(member, address, stride, 4, history, 4u)                                                              \
  SAVED_GOAL_ROW(member, address, stride, 5, history, 5u)                                                              \
  SAVED_GOAL_ROW(member, address, stride, 6, history, 6u)                                                              \
  SAVED_GOAL_ROW(member, address, stride, 7, history, 7u)                                                              \
  SAVED_GOAL_ROW(member, address, stride, 0, targets, 8u)                                                              \
  SAVED_GOAL_ROW(member, address, stride, 1, targets, 9u)                                                              \
  SAVED_GOAL_ROW(member, address, stride, 2, targets, 10u)                                                             \
  SAVED_GOAL_ROW(member, address, stride, 3, targets, 11u)                                                             \
  SAVED_GOAL_ROW(member, address, stride, 4, targets, 12u)                                                             \
  SAVED_GOAL_ROW(member, address, stride, 5, targets, 13u)                                                             \
  SAVED_GOAL_ROW(member, address, stride, 6, targets, 14u)                                                             \
  SAVED_GOAL_ROW(member, address, stride, 7, targets, 15u)
SAVED_GOAL_COLUMN(year, PT_FIELD_mission_year, sizeof(((PTNamedMemory *)0)->saved_mission_year[0]))
SAVED_GOAL_COLUMN(day, PT_FIELD_mission_day, sizeof(((PTNamedMemory *)0)->saved_mission_day[0]))
SAVED_GOAL_COLUMN(month, PT_FIELD_mission_month, sizeof(((PTNamedMemory *)0)->saved_mission_month[0]))
SAVED_GOAL_COLUMN(kind, PT_FIELD_mission_goal, sizeof(((PTNamedMemory *)0)->saved_mission_goal[0]))
#undef SAVED_GOAL_COLUMN
#undef SAVED_GOAL_ROW
